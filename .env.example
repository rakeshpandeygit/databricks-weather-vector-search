# National Weather Service requires a descriptive User-Agent header.
NWS_USER_AGENT=weather-vector-search/1.0 your-email@example.com

# Local Lakebase/PostgreSQL connection string.
# Example: postgresql://user:password@host:5432/dbname
LAKEBASE_URL=

# Databricks App deployment resolves Lakebase via scope/key env vars in app.yaml.
# LAKEBASE_SECRET_SCOPE=database
# LAKEBASE_SECRET_KEY=lakebase-url

# Optional Flask settings for local development.
PORT=5000
FLASK_DEBUG=0
